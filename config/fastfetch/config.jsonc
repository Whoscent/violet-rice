{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/Violetnonbg.png",
	"width": 28,
	"height": 12,
        "color": {
            "1": "38;2;184;160;200",
            "2": "38;2;232;196;160"
        },
        "padding": {
	"top": 1,
        "left": 0,
        "right": 6
	}
    },
    "display": {
        "separator": " ~  ",
        "color": {
            "separator": "38;2;108;95;122"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{6}{7}{8}",
            "keyColor": "38;2;232;196;160"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────"
        },
        {
            "type": "os",
            "key": "OS",
            "keyColor": "38;2;184;160;200",
            "format": "{3}"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "38;2;184;160;200"
        },
	{
	     "type": "uptime",
	     "key": "Uptime", 
	     "keyColor": "38;2;184;160;200"
	},
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "38;2;184;160;200",
            "format": "{2}"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "38;2;184;160;200"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "38;2;184;160;200",
            "format": "{5}"
        },
	{

	    "type": "display",
	    "key": "Display",
	    "keyColor": "38;2;184;160;200"
	
	},
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "38;2;184;160;200",
            "format": "{1}"
        },
	{
	    "type": "gpu",
	    "key": "GPU",
	    "keyColor": "38;2;184;160;200",
	    "format": "{1} {3}"
	},
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "38;2;184;160;200",
            "format": "{1} / {2}"
        },

	{

	    "type": "battery",
	    "key": "Battery",
	    "keyColor": "38;2;184;160;200"
            
	},
        {
            "type": "custom",
            "format": "──────────────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
